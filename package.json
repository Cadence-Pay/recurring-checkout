{
  "name": "recurring-checkout",
  "version": "0.1.0",
  "description": "Embeddable React subscribe button for Stellar Recurring.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cadence-Pay/recurring-checkout.git"
  },
  "homepage": "https://github.com/Cadence-Pay/recurring-checkout#readme",
  "bugs": {
    "url": "https://github.com/Cadence-Pay/recurring-checkout/issues"
  },
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "build:example": "tsup --config tsup.example.config.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@creit.tech/stellar-wallets-kit": "^2.8.0"
  },
  "devDependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.8.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0"
  },
  "peerDependenciesMeta": {
    "@creit.tech/stellar-wallets-kit": {
      "optional": true
    }
  }
}
